# Copie este arquivo para .env.local e preencha os valores.

# Origem pública do site (sem barra final) — usada pelo metadataBase para
# compor URLs absolutas em canonical/hreflang (Google exige full-qualified).
# Ex.: https://agathasales.com
SITE_URL=

# Adobe Fonts (Typekit) — ID do kit da conta Creative Cloud.
# Pegue em https://fonts.adobe.com/my_fonts#web_projects
# Ex.: se a URL do kit é https://use.typekit.net/abc1xyz.css, use abc1xyz.
NEXT_PUBLIC_TYPEKIT_ID=

# EmailJS — usado pelo formulário em /contato.
# Crie a conta em https://emailjs.com, configure o service (ex: Gmail),
# crie um template e copie as três strings abaixo.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
